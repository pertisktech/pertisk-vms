# Orange Pi 5 Max (RK3588). Prefer official Orange Pi OS as --base-image
# if the Armbian redirect 404s (community board).
BOARD=orangepi5max
FAMILY=rockchip
DTB=rockchip/rk3588-orangepi-5-max.dtb
IMAGE_URL=https://dl.armbian.com/orangepi5-max/Trixie_vendor_minimal
PACKAGES="qemu-system-arm qemu-efi-aarch64 ipxe-qemu qemu-utils gdisk parted dosfstools rsync"
SERIAL=ttyS2
