# Orange Pi 5 Plus (RK3588). Flash this image to SD, boot, open :7480.
BOARD=orangepi5plus
FAMILY=rockchip
DTB=rockchip/rk3588-orangepi-5-plus.dtb
# Armbian Debian + vendor kernel (KVM). Override with --base-image.
IMAGE_URL=https://dl.armbian.com/orangepi5-plus/Trixie_vendor_minimal
PACKAGES="qemu-system-arm qemu-efi-aarch64 ipxe-qemu qemu-utils gdisk parted dosfstools rsync"
SERIAL=ttyS2
