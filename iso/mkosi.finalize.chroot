#!/bin/bash
# Last chance to mutate the rootfs before the ESP is filled from /efi.
# Create initrd if linux-image did not, then stage FAT-only UEFI files.
set -euo pipefail
mkdir -p /efi /boot/efi

# Presets are not enough: Debian does not enable systemd-networkd by default,
# so USB live had no DHCP. Pin the units on.
systemctl enable systemd-networkd.service systemd-networkd.socket \
  systemd-networkd-wait-online.service ssh.service \
  pertisk-firstboot.service pertisk-net.service \
  pertisk-bootfix.service pertiskd.service || true
systemctl mask networking.service || true
systemctl disable NetworkManager.service || true
systemctl disable NetworkManager-wait-online.service || true

/usr/sbin/pertisk-esp-boot /efi

# Keep kernel+initrd on ext4 /boot. mkosi CopyFiles moves /efi → ESP only;
# systemd-gpt-auto then mounts that ESP at /efi (not /boot/efi). Without
# these files, pertisk-install chroot → "no kernel in /boot or ESP".
mkdir -p /boot
kver="$(ls -1 /lib/modules 2>/dev/null | sort -V | tail -n1 || true)"
if [[ -n "$kver" ]]; then
  if [[ -s /efi/vmlinuz ]]; then
    cp -f /efi/vmlinuz "/boot/vmlinuz-${kver}"
    cp -f /efi/vmlinuz /boot/vmlinuz
  elif [[ -s "/usr/lib/modules/${kver}/vmlinuz" ]]; then
    cp -f "/usr/lib/modules/${kver}/vmlinuz" "/boot/vmlinuz-${kver}"
    cp -f "/usr/lib/modules/${kver}/vmlinuz" /boot/vmlinuz
  fi
  if [[ -s /efi/initrd.img ]]; then
    cp -f /efi/initrd.img "/boot/initrd.img-${kver}"
    cp -f /efi/initrd.img /boot/initrd.img
  fi
  ln -sfn "vmlinuz-${kver}" /vmlinuz
  ln -sfn "initrd.img-${kver}" /initrd.img 2>/dev/null || true
fi
[[ -s /boot/vmlinuz ]] || { echo "mkosi.finalize: /boot/vmlinuz missing after esp-boot" >&2; ls -la /boot /efi >&2; exit 1; }
[[ -s /boot/initrd.img ]] || { echo "mkosi.finalize: /boot/initrd.img missing after esp-boot" >&2; exit 1; }

mkdir -p /boot/efi
cp -a /efi/. /boot/efi/ || true
exit 0
