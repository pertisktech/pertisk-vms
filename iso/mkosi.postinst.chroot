#!/bin/bash
# After packages are in the image, stage a FAT-only UEFI boot chain under /efi
# (copied onto the ESP by mkosi.repart CopyFiles=/efi:/).
set -euo pipefail
mkdir -p /efi /boot/efi
if [[ -x /usr/sbin/pertisk-esp-boot ]]; then
  /usr/sbin/pertisk-esp-boot /efi
  mkdir -p /boot/efi
  cp -a /efi/. /boot/efi/ || true
fi
exit 0
