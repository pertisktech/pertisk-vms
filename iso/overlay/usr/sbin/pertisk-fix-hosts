#!/bin/bash
# Idempotent /etc/hosts + hostname so sudo/getaddrinfo do not hit DNS.
# Usage: pertisk-fix-hosts [rootfs]
set -u

ROOT="${1:-/}"
ROOT="${ROOT%/}"
[[ -n "$ROOT" ]] || ROOT="/"
if [[ "$ROOT" == "/" ]]; then
  hosts=/etc/hosts
  hostname_file=/etc/hostname
else
  hosts="$ROOT/etc/hosts"
  hostname_file="$ROOT/etc/hostname"
fi

mkdir -p "$(dirname "$hosts")"
touch "$hosts"

host="$(tr -d ' \t\n' <"$hostname_file" 2>/dev/null || true)"
host="${host:-pertisk}"

if [[ ! -s "$hostname_file" ]]; then
  printf '%s\n' "$host" >"$hostname_file"
fi

if ! grep -qE '^[[:space:]]*127\.0\.0\.1[[:space:]]+' "$hosts"; then
  printf '127.0.0.1\tlocalhost\n' >>"$hosts"
fi

if grep -qE '^[[:space:]]*127\.0\.1\.1[[:space:]]+' "$hosts"; then
  if ! grep -qE "^[[:space:]]*127\\.0\\.1\\.1[[:space:]].*[[:space:]]${host}([[:space:]]|$)" "$hosts" \
    && ! grep -qE "^[[:space:]]*127\\.0\\.1\\.1[[:space:]]+${host}([[:space:]]|$)" "$hosts"; then
    sed -i -E "s/^[[:space:]]*127\\.0\\.1\\.1.*/127.0.1.1\t${host}/" "$hosts"
  fi
else
  printf '127.0.1.1\t%s\n' "$host" >>"$hosts"
fi

if ! grep -qE "(^|[[:space:]])${host}([[:space:]]|$)" "$hosts"; then
  printf '127.0.1.1\t%s\n' "$host" >>"$hosts"
fi

exit 0
