#!/bin/bash
# Idempotent /etc/hosts from the *existing* hostname.
# Never invent or overwrite /etc/hostname (Anaconda / hostnamectl own that).
# Usage: pertisk-fix-hosts [rootfs]
set -u

ROOT="${1:-/}"
ROOT="${ROOT%/}"
[[ -n "$ROOT" ]] || ROOT="/"
if [[ "$ROOT" == "/" ]]; then
  hosts=/etc/hosts
  hostname_file=/etc/hostname
else
  hosts="$ROOT/etc/hosts"
  hostname_file="$ROOT/etc/hostname"
fi

mkdir -p "$(dirname "$hosts")"
touch "$hosts"

host="$(tr -d ' \t\n' <"$hostname_file" 2>/dev/null || true)"
host="${host%%.*}"
# Fallbacks for /etc/hosts only — do not write these into /etc/hostname.
if [[ -z "$host" || "$host" == "localhost" || "$host" == "localhost.localdomain" ]]; then
  host="$(hostname -s 2>/dev/null || true)"
  host="${host%%.*}"
fi
if [[ -z "$host" || "$host" == "localhost" || "$host" == "localhost.localdomain" ]]; then
  host="localhost"
fi

# Only touch /etc/hostname if completely missing (never overwrite Anaconda).
if [[ ! -e "$hostname_file" ]]; then
  : # leave absent; systemd/Anaconda will create it
fi

if ! grep -qE '^[[:space:]]*127\.0\.0\.1[[:space:]]+' "$hosts"; then
  printf '127.0.0.1\tlocalhost\n' >>"$hosts"
fi

if [[ "$host" != "localhost" ]]; then
  if grep -qE '^[[:space:]]*127\.0\.1\.1[[:space:]]+' "$hosts"; then
    sed -i -E "s/^[[:space:]]*127\\.0\\.1\\.1.*/127.0.1.1\t${host}/" "$hosts"
  else
    printf '127.0.1.1\t%s\n' "$host" >>"$hosts"
  fi
fi

exit 0
