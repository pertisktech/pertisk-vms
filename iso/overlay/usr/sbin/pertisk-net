#!/bin/bash
# Ensure cabled ethernet has DHCP, then publish the address for the console.
# Prefer systemd-networkd; only fall back to dhclient on unmanaged NICs.
set -euo pipefail

mkdir -p /run /etc/issue.d
exec 9>/run/pertisk-net.lock
flock -n 9 || exit 0

ISSUE=/etc/issue.d/pertisk-ip.issue

skip() {
  case "$1" in
    lo | br* | docker* | veth* | tap* | wlan* | wl* | wwan*) return 0 ;;
  esac
  # Bridge slaves must not run DHCP themselves (lease would fight br0).
  [[ -e "/sys/class/net/$1/master" ]] && return 0
  return 1
}

systemctl start systemd-networkd.service >/dev/null 2>&1 || true

for path in /sys/class/net/*; do
  nic="${path##*/}"
  skip "$nic" && continue
  [[ -d "$path/device" ]] || continue
  ip link set "$nic" up || true
done

# Carrier can take a second after link-up.
sleep 2

if command -v networkctl >/dev/null; then
  networkctl reload >/dev/null 2>&1 || true
fi

have_ip() {
  ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | grep -q /
}

cabled=0
for path in /sys/class/net/*; do
  nic="${path##*/}"
  # Count carrier on physical ports even when enslaved (bridge path).
  case "$nic" in lo|docker*|veth*|tap*|wlan*|wl*|wwan*) continue ;; esac
  [[ -d "$path/device" ]] || [[ -d "$path/bridge" ]] || continue
  carrier="$(cat "$path/carrier" 2>/dev/null || echo 0)"
  if [[ "$carrier" == 1 ]]; then
    cabled=1
    break
  fi
done

if [[ "$cabled" -eq 0 ]]; then
  cat >"$ISSUE" <<'EOF'
Pertisk Vms  no cable — plug either 2.5G LAN port.
NVMe: pertisk-install --auto   repair: pertisk-fix-nvme-boot /dev/nvme0n1
EOF
  echo "pertisk-net: no carrier (plug a LAN cable)"
  ip -br link || true
  exit 0
fi

for _ in 1 2 3 4 5; do
  have_ip && break
  for path in /sys/class/net/*; do
    nic="${path##*/}"
    skip "$nic" && continue
    carrier="$(cat "$path/carrier" 2>/dev/null || echo 0)"
    [[ "$carrier" == 1 ]] || continue
    # Only if networkd is not already managing this link.
    if command -v networkctl >/dev/null \
      && networkctl status "$nic" 2>/dev/null | grep -qiE 'State:.*(configured|routable)'; then
      continue
    fi
    if command -v dhclient >/dev/null; then
      dhclient -1 "$nic" >/dev/null 2>&1 || true
    fi
  done
  sleep 2
done

# Public IPv6 only. fe80 and fd00/fc00 are not the address operators open.
public_ipv6() {
  ip -6 -o addr show scope global 2>/dev/null | awk '
    $2 == "lo" || $2 ~ /^(docker|veth|br-|virbr)/ { next }
    {
      addr = $4
      sub("/.*", "", addr)
      if (addr ~ /^[fF][eE]80:/) next
      if (index($0, "temporary") > 0) next
      if (addr ~ /^[fF][cCdD]/) next
      print addr
      exit
    }
  '
}

ips="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
ipv6=""
if [[ -n "$ips" ]]; then
  for _ in 1 2 3 4 5 6 7 8; do
    ipv6="$(public_ipv6 || true)"
    [[ -n "$ipv6" ]] && break
    sleep 1
  done
fi
if [[ -n "$ips" ]]; then
  if [[ -n "$ipv6" ]]; then
    printf 'Pertisk Vms  http://%s:7480/  IPv6 %s  user admin  password in /etc/pertisk/admin\n' "$ips" "$ipv6" >"$ISSUE"
  else
    printf 'Pertisk Vms  http://%s:7480/  user admin  password in /etc/pertisk/admin\n' "$ips" >"$ISSUE"
  fi
  echo "pertisk-net: $ips ${ipv6}"
  if [[ -x /usr/sbin/pertisk-fix-dns ]]; then
    /usr/sbin/pertisk-fix-dns || true
  fi
else
  cat >"$ISSUE" <<'EOF'
Pertisk Vms  cable up but no DHCP. Check the switch/router.
NVMe: pertisk-install --auto   repair: pertisk-fix-nvme-boot /dev/nvme0n1
EOF
  echo "pertisk-net: carrier but no IPv4"
fi
exit 0
