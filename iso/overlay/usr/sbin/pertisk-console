#!/bin/bash
# HDMI/serial console: root shell (no password). NVMe install is manual only.

echo
echo "pertisk-vm console (root shell, no login password)"
echo "  TUI:            pertisk-tui"
echo "  root password:  pertisk   (for ssh)"
echo "  UI:             http://<ip>:7480/  admin / (see /etc/pertisk/admin)"
echo
echo "  Install to NVMe (wipes disk):"
echo "    pertisk-install --auto"
echo "  If BIOS finds no boot entry after install:"
echo "    pertisk-fix-nvme-boot /dev/nvme0n1"
echo "  Then power OFF, UNPLUG USB, BIOS → Windows Boot Manager"
echo
ip -br a 2>/dev/null || ip -br link 2>/dev/null || true
echo

if [[ -x /usr/sbin/pertisk-net ]]; then
  /usr/sbin/pertisk-net >/tmp/pertisk-net.log 2>&1 &
fi

# HDMI/serial cannot render Nerd Fonts. Force a plain zsh prompt (see ~/.zshrc).
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
export PERTISK_CONSOLE=1
export POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
export POWERLEVEL9K_INSTANT_PROMPT=off
stty sane 2>/dev/null || true

if [[ -x /bin/zsh ]]; then
  export SHELL=/bin/zsh
  exec /bin/zsh -l
fi
exec /bin/bash --login
