#!/bin/bash
# HDMI/serial console: root shell (no password). NVMe install is manual only.

# Always run the Alma first-boot wizard when the flag is present (do not rely on
# --needed / os-flavor — that previously skipped straight to a shell).
if [[ -f /etc/pertisk/needs-setup && ! -f /var/lib/pertisk/.setup-done && -x /usr/sbin/pertisk-setup ]]; then
  export PERTISK_SETUP_RUNNING=1
  clear 2>/dev/null || true
  echo "Starting Pertisk setup wizard..."
  exec /usr/sbin/pertisk-setup
fi

echo
echo "pertisk-vm console (root shell, no login password)"
echo "  TUI:            pertisk-tui"
echo "  SSH root/admin: password you set in Anaconda"
echo "  Web UI:         https://<ip>:7443/  user admin  password admin"
echo "                  (change under Users after login)"
echo
if [[ -f /etc/pertisk/needs-setup ]]; then
  echo "  Setup incomplete: run  pertisk-setup"
elif [[ -x /usr/sbin/pertisk-install && ! -f /var/lib/pertisk/.installed-to-disk ]]; then
  echo "  Install to NVMe (wipes disk):"
  echo "    pertisk-install --auto"
  echo "  If BIOS finds no boot entry after install:"
  echo "    pertisk-fix-nvme-boot /dev/nvme0n1"
  echo "  Then power OFF, UNPLUG USB, BIOS → Windows Boot Manager"
else
  echo "  Disk/network: configured in Anaconda."
  echo "  Check:        systemctl status pertiskd"
fi
echo
ip -br a 2>/dev/null || ip -br link 2>/dev/null || true
echo

if [[ -x /usr/sbin/pertisk-net ]]; then
  /usr/sbin/pertisk-net >/tmp/pertisk-net.log 2>&1 &
fi

# HDMI/serial cannot render Nerd Fonts. Force a plain zsh prompt (see ~/.zshrc).
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
export PERTISK_CONSOLE=1
export POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
export POWERLEVEL9K_INSTANT_PROMPT=off
stty sane 2>/dev/null || true

if [[ -x /bin/zsh ]]; then
  export SHELL=/bin/zsh
  exec /bin/zsh -l
fi
exec /bin/bash --login
