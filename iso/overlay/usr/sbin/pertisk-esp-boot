#!/bin/bash
# Put a complete UEFI boot chain on a FAT ESP: monolithic GRUB + kernel +
# initrd + grub.cfg. GRUB never has to read ext4 (AMI mini PCs drop to grub>
# when prefix still points at the USB).
#
# Usage: pertisk-esp-boot [ESP_DIR]
#   ESP_DIR defaults to /boot/efi, or /efi during mkosi.
set -euo pipefail

esp="${1:-}"
if [[ -z "$esp" ]]; then
  if [[ -d /efi ]]; then
    esp=/efi
  else
    esp=/boot/efi
  fi
fi
mkdir -p "$esp/EFI/BOOT" "$esp/EFI/debian" "$esp/EFI/pertisk" "$esp/grub"

k=""
if [[ -e /boot/vmlinuz ]]; then
  k="$(readlink -f /boot/vmlinuz 2>/dev/null || true)"
  [[ -f "$k" ]] || k=/boot/vmlinuz
fi
if [[ -z "$k" || ! -f "$k" ]]; then
  k="$(ls -1 /boot/vmlinuz-* 2>/dev/null | grep -v '\.old$' | sort -V | tail -n1 || true)"
fi
[[ -n "$k" && -f "$k" ]] || { echo "pertisk-esp-boot: no kernel in /boot" >&2; ls -la /boot >&2 || true; exit 1; }

kver="${k##*/}"
kver="${kver#vmlinuz-}"

i=""
find_initrd() {
  i=""
  if [[ -e /boot/initrd.img ]]; then
    i="$(readlink -f /boot/initrd.img 2>/dev/null || true)"
    [[ -f "$i" ]] || i=/boot/initrd.img
  fi
  if [[ -z "$i" || ! -f "$i" ]]; then
    i="$(ls -1 /boot/initrd.img-* 2>/dev/null | grep -v '\.old$' | sort -V | tail -n1 || true)"
  fi
  if [[ -n "$kver" && -f "/boot/initrd.img-${kver}" ]]; then
    i="/boot/initrd.img-${kver}"
  fi
  [[ -n "$i" && -f "$i" ]]
}

if ! find_initrd; then
  echo "pertisk-esp-boot: generating initrd for ${kver}"
  if command -v update-initramfs >/dev/null; then
    update-initramfs -c -k "$kver" || update-initramfs -u -k "$kver" || true
  fi
fi
if ! find_initrd; then
  echo "pertisk-esp-boot: no initrd in /boot after update-initramfs" >&2
  ls -la /boot >&2 || true
  exit 1
fi

cp -fL "$k" "$esp/vmlinuz"
cp -fL "$i" "$esp/initrd.img"
mkdir -p "$esp/EFI/BOOT" "$esp/boot/grub"
cp -fL "$k" "$esp/EFI/BOOT/vmlinuz"
cp -fL "$i" "$esp/EFI/BOOT/initrd.img"
cp -fL "$k" "$esp/boot/grub/vmlinuz"
cp -fL "$i" "$esp/boot/grub/initrd.img"

case "$(uname -m)" in
  x86_64|amd64)
    bootname=BOOTX64.EFI
    grub_fmt=x86_64-efi
    extra="nomodeset modprobe.blacklist=amdgpu"
    ;;
  aarch64|arm64)
    bootname=BOOTAA64.EFI
    grub_fmt=arm64-efi
    extra=""
    ;;
  *)
    echo "pertisk-esp-boot: unsupported arch $(uname -m)" >&2
    exit 1
    ;;
esac

embed="$(mktemp)"
cfg_body="$(cat <<EOF
echo "pertisk loading kernel"
search --no-floppy --file --set=root /vmlinuz
linux /vmlinuz root=LABEL=pertisk-root rootwait rw console=tty0 console=ttyS0 ${extra}
initrd /initrd.img
boot
EOF
)"
printf '%s\n' "$cfg_body" >"$embed"

efi_out="$esp/EFI/BOOT/$bootname"
if command -v grub-mkimage >/dev/null && [[ -d "/usr/lib/grub/${grub_fmt}" ]]; then
  # Config is inside the .efi so AMI never searches /boot/grub on the USB/NVMe.
  grub-mkimage -O "$grub_fmt" -o "$efi_out" -p /EFI/BOOT -c "$embed" \
    part_gpt fat ext2 search linux echo normal boot configfile ls reboot halt \
    serial gzio || {
    echo "pertisk-esp-boot: grub-mkimage failed" >&2
    exit 1
  }
else
  echo "pertisk-esp-boot: grub-mkimage missing" >&2
  exit 1
fi
rm -f "$embed"
cp -f "$efi_out" "$esp/EFI/BOOT/grubx64.efi" 2>/dev/null || true
cp -f "$efi_out" "$esp/EFI/debian/grubx64.efi" 2>/dev/null || true
cp -f "$efi_out" "$esp/EFI/debian/$bootname" 2>/dev/null || true

printf '%s\n' "$cfg_body" >"$esp/EFI/BOOT/grub.cfg"
mkdir -p "$esp/boot/grub" "$esp/grub" "$esp/EFI/debian" "$esp/EFI/pertisk"
cp -f "$esp/EFI/BOOT/grub.cfg" "$esp/boot/grub/grub.cfg"
cp -f "$esp/EFI/BOOT/grub.cfg" "$esp/grub/grub.cfg"
cp -f "$esp/EFI/BOOT/grub.cfg" "$esp/EFI/debian/grub.cfg"
cp -f "$esp/EFI/BOOT/grub.cfg" "$esp/EFI/pertisk/grub.cfg"
sync
echo "pertisk-esp-boot: embedded $efi_out + vmlinuz (root=LABEL=pertisk-root)"
exit 0
