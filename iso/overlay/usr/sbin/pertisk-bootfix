#!/bin/bash
# Repair UEFI boot on the running system (every boot). FAT ESP only.
set -euo pipefail
[[ "$(id -u)" -eq 0 ]] || exit 0
[[ -d /sys/firmware/efi ]] || exit 0
if ! mountpoint -q /boot/efi; then
  mkdir -p /boot/efi
  mount /boot/efi >/dev/null 2>&1 || exit 0
fi
exec /usr/sbin/pertisk-esp-boot /boot/efi
