#!/bin/bash
# Repair NVMe UEFI boot from a live USB.
# Usage: pertisk-fix-nvme-boot [/dev/nvme0n1]
set -euo pipefail

die() { echo "pertisk-fix-nvme-boot: $*" >&2; exit 1; }
[[ "$(id -u)" -eq 0 ]] || die "run as root"
[[ -d /sys/firmware/efi ]] || die "boot this USB in UEFI mode (not legacy/CSM)"

live="$(lsblk -no PKNAME "$(findmnt -n -o SOURCE /)" 2>/dev/null | head -n1 || true)"
DISK="${1:-}"
if [[ -z "$DISK" ]]; then
  DISK="$(blkid -L pertisk-root 2>/dev/null || true)"
  if [[ -n "$DISK" ]]; then
    DISK="/dev/$(lsblk -no PKNAME "$DISK" | head -n1)"
  fi
fi
if [[ -z "$DISK" ]]; then
  DISK="$(lsblk -dpn -o NAME,TRAN | awk '$2!="usb" && $2!="mmc" && $1 ~ /nvme|sd/ {print $1; exit}')"
fi
[[ -n "$DISK" && -b "$DISK" ]] || die "no NVMe found (pass /dev/nvme0n1)"
DISK="$(readlink -f "/dev/${DISK#/dev/}")"
[[ "$(basename "$DISK")" != "$live" ]] || die "$DISK is the USB; pass the NVMe"

if [[ "$DISK" == *[0-9] ]]; then
  p1="${DISK}p1"
  p2="${DISK}p2"
else
  p1="${DISK}1"
  p2="${DISK}2"
fi
[[ -b "$p1" && -b "$p2" ]] || die "expected $p1 (ESP) and $p2 (root) — run pertisk-install --auto first"

# Force ESP GPT type before mounting.
if command -v sgdisk >/dev/null; then
  sgdisk -t 1:ef00 "$DISK" >/dev/null 2>&1 || true
fi
parted -s "$DISK" set 1 esp on >/dev/null 2>&1 || true
parted -s "$DISK" set 1 boot on >/dev/null 2>&1 || true
partprobe "$DISK" >/dev/null 2>&1 || true
udevadm settle --timeout=5 >/dev/null 2>&1 || true

mnt=/mnt/pertisk-fix-nvme
mkdir -p "$mnt"
umount -R "$mnt" >/dev/null 2>&1 || true
mount "$p2" "$mnt"
mkdir -p "$mnt/boot/efi"
mount "$p1" "$mnt/boot/efi"
mount --bind /dev "$mnt/dev"
mount --bind /dev/pts "$mnt/dev/pts"
mount -t proc proc "$mnt/proc"
mount -t sysfs sys "$mnt/sys"

cleanup() {
  umount "$mnt/dev/pts" "$mnt/dev" "$mnt/proc" "$mnt/sys" "$mnt/boot/efi" "$mnt" >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "pertisk-fix-nvme-boot: ESP $p1  root $p2"

root_uuid="$(blkid -s UUID -o value "$p2" || true)"
esp_uuid="$(blkid -s UUID -o value "$p1" || true)"
if [[ -n "$root_uuid" ]]; then
  cat >"$mnt/etc/fstab" <<EOF
UUID=$root_uuid / ext4 defaults 0 1
${esp_uuid:+UUID=$esp_uuid /boot/efi vfat umask=0077 0 2}
EOF
fi

mkdir -p "$mnt/etc/initramfs-tools" "$mnt/etc/initramfs-tools/conf.d" "$mnt/usr/sbin"
for f in modules; do
  [[ -f /etc/initramfs-tools/$f ]] && cp -f "/etc/initramfs-tools/$f" "$mnt/etc/initramfs-tools/$f"
done
[[ -f /etc/initramfs-tools/conf.d/pertisk-storage.conf ]] && \
  cp -f /etc/initramfs-tools/conf.d/pertisk-storage.conf \
    "$mnt/etc/initramfs-tools/conf.d/pertisk-storage.conf"
for f in pertisk-esp-boot pertisk-uefi-register; do
  [[ -x /usr/sbin/$f ]] && cp -f "/usr/sbin/$f" "$mnt/usr/sbin/$f" && chmod 755 "$mnt/usr/sbin/$f"
done

# Prefer live USB kernel/initrd onto target /boot if missing (old installs).
# Live ESP is usually at /efi (gpt-auto), not /boot/efi.
mkdir -p "$mnt/boot"
if ! findmnt -n /efi >/dev/null 2>&1 && ! findmnt -n /boot/efi >/dev/null 2>&1; then
  live_disk="/dev/${live}"
  if [[ -n "$live" && -b "$live_disk" ]]; then
    if [[ "$live_disk" == *[0-9] ]]; then live_esp="${live_disk}p1"; else live_esp="${live_disk}1"; fi
    if [[ -b "$live_esp" ]]; then
      mkdir -p /efi
      mount "$live_esp" /efi 2>/dev/null || true
    fi
  fi
fi
for f in vmlinuz initrd.img; do
  if [[ -s "$mnt/boot/$f" ]]; then
    continue
  fi
  for src in \
    "/boot/$f" \
    "/efi/$f" \
    "/efi/EFI/BOOT/$f" \
    "/boot/efi/$f" \
    "/boot/efi/EFI/BOOT/$f"; do
    if [[ -s "$src" ]]; then
      cp -fL "$src" "$mnt/boot/$f"
      break
    fi
  done
done
if [[ ! -s "$mnt/boot/vmlinuz" ]]; then
  k="$(ls -1 /usr/lib/modules/*/vmlinuz 2>/dev/null | sort -V | tail -n1 || true)"
  [[ -s "$k" ]] || die "no live kernel in /boot /efi /usr/lib/modules"
  kver="$(basename "$(dirname "$k")")"
  cp -fL "$k" "$mnt/boot/vmlinuz"
  cp -fL "$k" "$mnt/boot/vmlinuz-${kver}"
fi
if [[ ! -s "$mnt/boot/initrd.img" ]]; then
  # Will try update-initramfs below; still stage versioned if present on live.
  for src in /boot/initrd.img-* /efi/initrd.img /efi/EFI/BOOT/initrd.img; do
    if [[ -s "$src" ]]; then
      cp -fL "$src" "$mnt/boot/initrd.img"
      break
    fi
  done
fi

echo "pertisk-fix-nvme-boot: rebuilding initramfs + ESP bootloader"
chroot "$mnt" update-initramfs -u -k all || chroot "$mnt" update-initramfs -c -k all || true
if [[ ! -s "$mnt/boot/initrd.img" ]]; then
  gen="$(ls -1 "$mnt/boot"/initrd.img-* 2>/dev/null | sort -V | tail -n1 || true)"
  [[ -n "$gen" ]] && cp -f "$gen" "$mnt/boot/initrd.img"
fi
[[ -s "$mnt/boot/vmlinuz" ]] || die "target /boot/vmlinuz missing"
[[ -s "$mnt/boot/initrd.img" ]] || die "target /boot/initrd.img missing after update-initramfs"
if [[ -x "$mnt/usr/sbin/pertisk-esp-boot" ]]; then
  chroot "$mnt" /usr/sbin/pertisk-esp-boot /boot/efi
else
  die "no pertisk-esp-boot on $p2"
fi

# Verify ESP contents before NVRAM.
for need in \
  "$mnt/boot/efi/EFI/BOOT/BOOTX64.EFI" \
  "$mnt/boot/efi/EFI/BOOT/vmlinuz" \
  "$mnt/boot/efi/EFI/BOOT/initrd.img" \
  "$mnt/boot/efi/EFI/Microsoft/Boot/bootmgfw.efi"; do
  [[ -s "$need" ]] || die "missing $need after esp-boot"
done
sync
ls -la "$mnt/boot/efi/EFI/BOOT" "$mnt/boot/efi/EFI/Microsoft/Boot"

# Unmount before register remounts ESP.
cleanup
trap - EXIT

if [[ -x /usr/sbin/pertisk-uefi-register ]]; then
  /usr/sbin/pertisk-uefi-register "$DISK" 1
else
  die "pertisk-uefi-register missing"
fi

echo
echo "════════════════════════════════════════════════════"
echo "  Boot repair finished for $DISK"
echo "  1) Power OFF (not reboot)"
echo "  2) UNPLUG this USB stick"
echo "  3) Power ON → BIOS Boot → Windows Boot Manager"
echo "  Disable Secure Boot / CSM Legacy if still stuck"
echo "════════════════════════════════════════════════════"
exit 0
