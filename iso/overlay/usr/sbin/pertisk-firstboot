#!/bin/bash
# One-shot appliance setup. Safe to re-run until /var/lib/pertisk/.firstboot-done exists.
set -euo pipefail

HOME_DIR="${PERTISK_HOME:-/var/lib/pertisk}"
ENV_FILE=/etc/pertisk/daemon.env
PASS_FILE=/etc/pertisk/admin
ISSUE=/etc/issue.d/pertisk.issue

mkdir -p "$HOME_DIR/run" "$HOME_DIR/storage" "$HOME_DIR/state" /etc/pertisk /etc/issue.d
chmod 755 /etc/pertisk

is_installer_media() {
  local live tran rem
  live="$(lsblk -no PKNAME "$(findmnt -n -o SOURCE /)" 2>/dev/null | head -n1 || true)"
  [[ -n "$live" ]] || return 1
  tran="$(lsblk -dno TRAN "/dev/${live}" 2>/dev/null || true)"
  case "$tran" in
    usb|mmc) return 0 ;;
  esac
  rem="$(cat "/sys/block/${live}/removable" 2>/dev/null || echo 0)"
  [[ "$rem" == 1 ]]
}

# Optional unattended flash only when /etc/pertisk/install sets PERTISK_AUTO_INSTALL=1.
maybe_auto_disk_install() {
  [[ -f "$HOME_DIR/.installed-to-disk" ]] && return 0
  [[ -x /usr/sbin/pertisk-install ]] || return 0
  local auto=0
  if [[ -r /etc/pertisk/install ]]; then
    # shellcheck disable=SC1091
    set +u
    # shellcheck source=/dev/null
    source /etc/pertisk/install
    set -u
    auto="${PERTISK_AUTO_INSTALL:-0}"
  fi
  [[ "$auto" == "1" ]] || return 0
  is_installer_media || return 0
  echo "pertisk-firstboot: PERTISK_AUTO_INSTALL=1 — copying OS to largest NVMe/SATA (wipes target)"
  if /usr/sbin/pertisk-install --auto; then
    touch "$HOME_DIR/.installed-to-disk"
    echo "pertisk-firstboot: installed. Unplug USB. Rebooting..."
    sleep 8
    systemctl reboot
    exit 0
  fi
  echo "pertisk-firstboot: auto-install failed. Run: pertisk-install --auto" >&2
}

maybe_auto_disk_install

kvm_ok=1
if ! /usr/sbin/pertisk-kvm-check; then
  kvm_ok=0
  echo "pertisk-firstboot: KVM/SVM is off — disk install is fine; guests will not start until firmware virtualization is enabled" >&2
fi

if [[ ! -f "$HOME_DIR/config.toml" ]]; then
  if [[ -f /etc/pertisk/config.toml ]]; then
    cp /etc/pertisk/config.toml "$HOME_DIR/config.toml"
  fi
fi

node="$(hostname -s 2>/dev/null || echo pertisk)"
if [[ -f "$HOME_DIR/config.toml" ]] && ! grep -q 'node_name' "$HOME_DIR/config.toml"; then
  tmp="$(mktemp)"
  awk -v n="$node" '
    /^\[cluster\]/ { print; print "node_name = \"" n "\""; next }
    { print }
  ' "$HOME_DIR/config.toml" >"$tmp"
  mv "$tmp" "$HOME_DIR/config.toml"
fi

if [[ -z "${PERTISK_ADMIN_PASSWORD:-}" ]]; then
  if [[ -r "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    set -a
    source "$ENV_FILE"
    set +a
  fi
fi

if [[ -r /etc/pertisk/join ]]; then
  # shellcheck disable=SC1091
  set -a
  source /etc/pertisk/join
  set +a
fi

if [[ -z "${PERTISK_ADMIN_PASSWORD:-}" ]]; then
  PERTISK_ADMIN_PASSWORD="admin"
  echo "pertisk-firstboot: using default admin password (set PERTISK_ADMIN_PASSWORD to override)"
fi
umask 077
touch "$ENV_FILE"
if ! grep -q '^PERTISK_ADMIN_PASSWORD=' "$ENV_FILE" 2>/dev/null; then
  printf 'PERTISK_ADMIN_PASSWORD=%s\n' "$PERTISK_ADMIN_PASSWORD" >>"$ENV_FILE"
fi
printf '%s\n' "$PERTISK_ADMIN_PASSWORD" >"$PASS_FILE"
chmod 600 "$ENV_FILE" "$PASS_FILE"

ensure_ssh_login() {
  local oldumask
  oldumask="$(umask)"
  umask 022
  mkdir -p /etc/ssh/sshd_config.d
  cat >/etc/ssh/sshd_config.d/pertisk.conf <<'EOF'
PermitRootLogin yes
PasswordAuthentication yes
KbdInteractiveAuthentication yes
UsePAM yes
EOF
  echo "root:pertisk" | chpasswd 2>/dev/null || true
  local login_shell=/bin/bash
  [[ -x /bin/zsh ]] && login_shell=/bin/zsh
  if ! id -u admin >/dev/null 2>&1; then
    useradd -m -s "$login_shell" -G sudo admin 2>/dev/null || true
  fi
  if id -u admin >/dev/null 2>&1; then
    echo "admin:${PERTISK_ADMIN_PASSWORD}" | chpasswd 2>/dev/null || true
  fi
  umask "$oldumask"
  systemctl reload ssh.service 2>/dev/null || systemctl restart ssh.service 2>/dev/null || true
}

ensure_ssh_login

if [[ -x /usr/sbin/pertisk-fix-hosts ]]; then
  /usr/sbin/pertisk-fix-hosts || echo "pertisk-firstboot: hosts fix skipped" >&2
elif ! grep -qE '^127\.0\.1\.1[[:space:]]+pertisk' /etc/hosts 2>/dev/null; then
  echo "127.0.1.1 pertisk" >>/etc/hosts
fi

if [[ -n "${PERTISK_JOIN:-}" ]]; then
  if ! grep -q '^PERTISK_JOIN=' "$ENV_FILE" 2>/dev/null; then
    printf 'PERTISK_JOIN=%s\n' "$PERTISK_JOIN" >>"$ENV_FILE"
  fi
  if [[ -n "${PERTISK_JOIN_USER:-}" ]] && ! grep -q '^PERTISK_JOIN_USER=' "$ENV_FILE"; then
    printf 'PERTISK_JOIN_USER=%s\n' "$PERTISK_JOIN_USER" >>"$ENV_FILE"
  fi
  echo "pertisk-firstboot: will join $PERTISK_JOIN"
fi

ips="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
ips="${ips:-$(hostname -I 2>/dev/null | awk '{print $1}')}"
ips="${ips:-none}"

ensure_fstab() {
  [[ -f /etc/fstab ]] && return 0
  command -v findmnt >/dev/null || return 0
  command -v blkid >/dev/null || return 0
  local root_src root_uuid esp_dev esp_uuid
  root_src="$(findmnt -n -o SOURCE / || true)"
  root_uuid="$(findmnt -n -o UUID / 2>/dev/null || blkid -s UUID -o value "$root_src" 2>/dev/null || true)"
  [[ -n "$root_uuid" ]] || return 0
  esp_dev=""
  if findmnt -n /boot/efi >/dev/null 2>&1; then
    esp_dev="$(findmnt -n -o SOURCE /boot/efi)"
  elif [[ -n "$root_src" ]]; then
    local base="${root_src%%[0-9]}"
    base="${base%p}"
    [[ -b "${base}p1" ]] && esp_dev="${base}p1"
    [[ -z "$esp_dev" && -b "${base}1" ]] && esp_dev="${base}1"
  fi
  esp_uuid=""
  if [[ -n "$esp_dev" ]]; then
    esp_uuid="$(blkid -s UUID -o value "$esp_dev" 2>/dev/null || true)"
  fi
  {
    echo "UUID=$root_uuid / ext4 defaults 0 1"
    if [[ -n "$esp_uuid" ]]; then
      echo "UUID=$esp_uuid /boot/efi vfat umask=0077 0 2"
    fi
  } >/etc/fstab
}

show_install_hint() {
  [[ -f "$HOME_DIR/.installed-to-disk" ]] && return 1
  is_installer_media
}

ensure_fstab

# On live USB, skip heavy bridge setup so the console appears quickly for NVMe install.
if ! is_installer_media; then
  if [[ -x /usr/sbin/pertisk-bootfix ]]; then
    /usr/sbin/pertisk-bootfix || echo "pertisk-firstboot: bootfix skipped" >&2
  fi
  if [[ -x /usr/sbin/pertisk-host-bridge ]]; then
    umask 022
    /usr/sbin/pertisk-host-bridge || echo "pertisk-firstboot: br0 setup skipped" >&2
  fi
fi

seed_lan_network() {
  local state nets id
  state="$HOME_DIR/state"
  nets="$state/networks.json"
  mkdir -p "$state"
  [[ -f "$nets" ]] && return 0
  [[ -d /sys/class/net/br0/bridge ]] || return 0
  id="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || true)"
  [[ -n "$id" ]] || id="aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeee0001"
  cat >"$nets" <<EOF
{
  "networks": {
    "$id": {
      "id": "$id",
      "name": "lan",
      "bridge": "br0",
      "cidr": "0.0.0.0/0",
      "dhcp": false,
      "isolate": false,
      "mode": "bridge"
    }
  }
}
EOF
}

seed_lan_network

# Image build already clones Oh My Zsh. Retry on disk installs only — live USB
# must reach the HDMI console quickly for pertisk-install.
if ! is_installer_media && [[ -x /usr/sbin/pertisk-zsh-setup ]]; then
  /usr/sbin/pertisk-zsh-setup || echo "pertisk-firstboot: zsh setup skipped" >&2
fi

if [[ "$kvm_ok" -eq 0 ]]; then
  cat >"$ISSUE" <<'EOF'
pertisk-vm: enable SVM/VT-x in firmware for guests. Disk install does not need it.
Then: systemctl restart pertiskd
EOF
else
  cat >"$ISSUE" <<EOF
pertisk-vm  http://${ips}:7480/   user admin   password ${PERTISK_ADMIN_PASSWORD}
No IP yet? Plug a LAN cable. NVMe: pertisk-install --auto
EOF
fi

{
  echo "pertisk-vm node"
  if show_install_hint; then
    echo "Install to NVMe:   pertisk-install --auto"
    echo "Repair NVMe boot:  pertisk-fix-nvme-boot /dev/nvme0n1"
  else
    echo "Running from disk (no pertisk-install needed)."
  fi
  if [[ "$ips" == none ]]; then
    echo "No DHCP yet. Plug either 2.5G LAN port; UI is http://<ip>:7480/"
  else
    echo "UI:               http://${ips}:7480/  user admin  password ${PERTISK_ADMIN_PASSWORD}"
  fi
  echo "Console TUI:      pertisk-tui"
} >/etc/motd

touch "$HOME_DIR/.firstboot-done"
echo "pertisk-firstboot: done. UI http://${ips}:7480/"
exit 0
