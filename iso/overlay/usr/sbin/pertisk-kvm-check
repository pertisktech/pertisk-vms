#!/bin/sh
# Exit 0 only when this machine can run KVM guests.
set -eu

if [ ! -e /dev/kvm ]; then
  echo "pertisk: /dev/kvm is missing (enable virtualization in firmware)" >&2
  exit 1
fi

# x86 KVM shows svm/vmx in cpuinfo. aarch64 KVM does not.
case "$(uname -m)" in
  aarch64|arm64) exit 0 ;;
esac

if [ -r /proc/cpuinfo ] && ! grep -Eq 'svm|vmx' /proc/cpuinfo; then
  echo "pertisk: CPU has no svm/vmx flag (virtualization disabled in firmware?)" >&2
  exit 1
fi

exit 0
