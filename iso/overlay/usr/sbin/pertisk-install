#!/bin/bash
# Copy the running live/appliance root onto a target disk (Proxmox-style install).
# Usage: pertisk-install --disk /dev/nvme0n1 --yes
#        pertisk-install --list
set -euo pipefail

DISK=""
YES=0
LIST=0
AUTO=0
ESP_MIB=512
BOOT_MIB=1024
MIN_GIB=20
# Rockchip idbloader / u-boot.itb live in the gap before the first partition.
RK_GAP_MIB=32

die() { echo "pertisk-install: $*" >&2; exit 1; }

list_disks() {
  echo "NAME SIZE MODEL TRAN"
  if command -v lsblk >/dev/null; then
    lsblk -d -n -o NAME,SIZE,MODEL,TRAN 2>/dev/null | grep -Ev '^(loop|sr)' || true
  else
    echo "(lsblk not found)"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --disk) DISK="$2"; shift 2 ;;
    --yes) YES=1; shift ;;
    --auto) AUTO=1; YES=1; shift ;;
    --list) LIST=1; shift ;;
    --min-gib) MIN_GIB="$2"; shift 2 ;;
    -h|--help)
      echo "Usage: pertisk-install --disk /dev/nvme0n1 --yes"
      echo "       pertisk-install --auto"
      echo "       pertisk-install --list"
      echo "Installs this live image onto DISK (or the largest NVMe/SATA disk with --auto). Wipes the whole disk."
      echo "A partition like /dev/nvme0n1p2 is accepted; the whole SSD is used (p1=ESP, p2=root)."
      echo "Needs no network and no KVM. UEFI PCs get GPT + ESP + GRUB. Orange Pi / Raspberry Pi get vendor U-Boot layout."
      exit 0
      ;;
    *) die "unknown arg $1" ;;
  esac
done

if [[ "$LIST" -eq 1 ]]; then
  list_disks
  exit 0
fi

[[ "$(id -u)" -eq 0 ]] || die "run as root"
# Disk copy does not need KVM or a network. Guests still need SVM/VT-x later.

is_usb_or_removable() {
  local d="$1" tran rem
  [[ -n "$d" ]] || return 1
  tran="$(lsblk -dno TRAN "/dev/${d}" 2>/dev/null || true)"
  case "$tran" in
    usb|mmc) return 0 ;;
  esac
  rem="$(cat "/sys/block/${d}/removable" 2>/dev/null || echo 0)"
  [[ "$rem" == 1 ]]
}

pick_install_disk() {
  local live="" name size tran best="" best_sz=0
  live="$(lsblk -no PKNAME "$(findmnt -n -o SOURCE /)" 2>/dev/null | head -n1 || true)"
  while read -r name size tran; do
    [[ -n "$name" ]] || continue
    [[ "$name" == "$live" ]] && continue
    is_usb_or_removable "$name" && continue
    case "$name" in
      nvme*|sd*|vd*|hd*|xvd*) ;;
      *) continue ;;
    esac
    if [[ "$size" -gt "$best_sz" ]]; then
      best="$name"
      best_sz="$size"
    fi
  done < <(lsblk -d -b -n -o NAME,SIZE,TRAN 2>/dev/null || true)
  [[ -n "$best" ]] || return 1
  printf '/dev/%s\n' "$best"
}

whole_disk() {
  local d pk
  d="${1#/dev/}"
  d="${d%/}"
  [[ -n "$d" ]] || return 1
  pk="$(lsblk -no PKNAME "/dev/${d}" 2>/dev/null | awk 'NF{print; exit}' || true)"
  if [[ -n "$pk" ]]; then
    printf '/dev/%s\n' "$pk"
    return 0
  fi
  printf '/dev/%s\n' "$d"
}

if [[ -z "$DISK" && "$AUTO" -eq 1 ]]; then
  DISK="$(pick_install_disk || true)"
  [[ -n "$DISK" ]] || die "no NVMe/SATA disk found to install to"
  echo "pertisk-install: auto target $DISK"
fi
if [[ -z "$DISK" ]]; then
  echo "pertisk-install: pass --disk or --auto (candidates):" >&2
  list_disks >&2
  die "pass --disk /dev/nvme0n1 --yes  or  --auto"
fi
[[ -b "$DISK" ]] || die "$DISK is not a block device"
DISK="$(whole_disk "$DISK")"
[[ -b "$DISK" ]] || die "$DISK is not a block device"
echo "pertisk-install: whole disk $DISK (ESP + root partitions)"
[[ "$YES" -eq 1 ]] || die "refusing to wipe $DISK without --yes"

require_healthy_live_root() {
  local src dev
  if findmnt -n -o OPTIONS / 2>/dev/null | tr ',' '\n' | grep -qx 'ro'; then
    die "live USB root is read-only (ext4 I/O). Re-flash a 16GB+ USB with xzcat|dd; do not install from this stick"
  fi
  src="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
  src="${src#/dev/}"
  src="${src%% *}"
  [[ -n "$src" ]] || return 0
  dev="${src##*/}"
  if dmesg 2>/dev/null | grep -i 'EXT4-fs error' | grep -Fq "(device ${dev})"; then
    die "live USB ext4 is already failing (EIO / directory block). Re-flash a 16GB+ USB; installing now would copy a broken disk"
  fi
}

require_healthy_live_root

root_src="$(findmnt -n -o SOURCE / || true)"
if [[ -n "$root_src" && "$root_src" == "$DISK"* ]]; then
  die "$DISK looks like the current root ($root_src); boot the live image first"
fi

bytes="$(blockdev --getsize64 "$DISK")"
gib=$((bytes / 1024 / 1024 / 1024))
[[ "$gib" -ge "$MIN_GIB" ]] || die "$DISK is ${gib}GiB; need at least ${MIN_GIB}GiB"

parts_for() {
  local d="$1"
  case "$d" in
    *[0-9]) echo "${d}p1" "${d}p2" ;;
    *) echo "${d}1" "${d}2" ;;
  esac
}

rescan_parts() {
  local d="$1"
  sync
  blockdev --rereadpt "$d" >/dev/null 2>&1 || true
  partprobe "$d" >/dev/null 2>&1 || true
  partx -u "$d" >/dev/null 2>&1 || partx -a "$d" >/dev/null 2>&1 || true
  udevadm settle --timeout=8 >/dev/null 2>&1 || true
}

wait_parts() {
  local p1="$1" p2="$2" i sys
  rescan_parts "$DISK"
  for i in $(seq 1 20); do
    [[ -b "$p1" && -b "$p2" ]] && return 0
    sys="/sys/class/block/$(basename "$p1")"
    if [[ -d "$sys" && ! -b "$p1" ]]; then
      udevadm trigger --action=add --sysname-match="$(basename "$p1")" >/dev/null 2>&1 || true
      udevadm trigger --action=add --sysname-match="$(basename "$p2")" >/dev/null 2>&1 || true
      udevadm settle --timeout=5 >/dev/null 2>&1 || true
    fi
    sleep 1
    rescan_parts "$DISK"
  done
  echo "pertisk-install: kernel partition table:" >&2
  sgdisk -p "$DISK" >&2 || true
  lsblk "$DISK" >&2 || true
  die "partitions $p1 $p2 did not appear"
}

rsync_root_to() {
  local mnt="$1"
  rsync -aHAX --numeric-ids --one-file-system --info=progress2 \
    --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/run \
    --exclude=/mnt --exclude=/tmp --exclude=/media --exclude=/boot \
    / "$mnt/"
  mkdir -p "$mnt/proc" "$mnt/sys" "$mnt/dev" "$mnt/run" "$mnt/tmp" "$mnt/boot"
  sync
}

detect_family() {
  if [[ -r /etc/pertisk/family ]]; then
    cat /etc/pertisk/family
    return
  fi
  if [[ -d /sys/firmware/efi ]]; then
    echo uefi
    return
  fi
  local compat=""
  if [[ -r /proc/device-tree/compatible ]]; then
    compat="$(tr '\0' '\n' </proc/device-tree/compatible)"
  fi
  case "$compat" in
    *rk3588* | *rockchip*) echo rockchip ;;
    *bcm2712* | *raspberrypi,5* | *brcm,bcm2712*) echo rpi ;;
    *)
      if [[ -d /sys/firmware/efi ]]; then
        echo uefi
      else
        die "unknown board (no EFI, no RK3588/Pi5 device-tree). Set /etc/pertisk/family"
      fi
      ;;
  esac
}

write_uboot_rockchip() {
  local target="$1"
  local dir img
  if [[ -f /usr/lib/u-boot/platform_install.sh ]]; then
    # shellcheck disable=SC1091
    source /usr/lib/u-boot/platform_install.sh
    dir="/usr/lib/u-boot"
    if [[ "$(type -t write_uboot_platform)" == function ]]; then
      write_uboot_platform "$dir" "$target" || true
    fi
    if [[ -b /dev/mtdblock0 && "$(type -t write_uboot_platform_mtd)" == function ]]; then
      write_uboot_platform_mtd "$dir" /dev/mtdblock0 || \
        echo "pertisk-install: SPI write failed; keep the SD until NVMe boots" >&2
    fi
    return
  fi
  img="$(find /usr/lib -name idbloader.img 2>/dev/null | head -n1 || true)"
  [[ -n "$img" ]] || img="$(find /usr/share -name idbloader.img 2>/dev/null | head -n1 || true)"
  dir="$(dirname "${img:-.}")"
  if [[ -f "$dir/idbloader.img" && -f "$dir/u-boot.itb" ]]; then
    dd if="$dir/idbloader.img" of="$target" seek=64 conv=notrunc status=none
    dd if="$dir/u-boot.itb" of="$target" seek=16384 conv=notrunc status=none
  else
    echo "pertisk-install: no Rockchip U-Boot files; SD/SPI loader must stay" >&2
  fi
  if [[ -b /dev/mtdblock0 ]]; then
    local spi
    spi="$(find /usr/lib /usr/share -name rkspi_loader.img 2>/dev/null | head -n1 || true)"
    if [[ -n "$spi" ]]; then
      dd if="$spi" of=/dev/mtdblock0 conv=notrunc status=progress || \
        echo "pertisk-install: SPI write failed; keep the SD until NVMe boots" >&2
    fi
  fi
}

patch_boot_root() {
  local bootdir="$1" root_uuid="$2"
  local f
  for f in "$bootdir/orangepiEnv.txt" "$bootdir/armbianEnv.txt"; do
    [[ -f "$f" ]] || continue
    if grep -q '^rootdev=' "$f"; then
      sed -i "s|^rootdev=.*|rootdev=UUID=${root_uuid}|" "$f"
    else
      printf 'rootdev=UUID=%s\n' "$root_uuid" >>"$f"
    fi
    if grep -q '^rootfstype=' "$f"; then
      sed -i 's|^rootfstype=.*|rootfstype=ext4|' "$f"
    fi
  done
  for f in "$bootdir/cmdline.txt" "$bootdir/firmware/cmdline.txt"; do
    [[ -f "$f" ]] || continue
    sed -i -E "s|root=[^ ]+|root=UUID=${root_uuid}|" "$f"
  done
  if [[ -f "$bootdir/extlinux/extlinux.conf" ]]; then
    sed -i -E "s|root=UUID=[^ ]+|root=UUID=${root_uuid}|g" "$bootdir/extlinux/extlinux.conf"
  fi
}

register_uefi_boot() {
  local disk="$1" part="${2:-1}" loader num order win
  [[ -d /sys/firmware/efi ]] || return 0
  command -v efibootmgr >/dev/null || return 0
  # Drop stale "pertisk" / leftover GRUB / WBM entries from failed installs.
  while read -r num; do
    [[ -n "$num" ]] || continue
    efibootmgr -b "$num" -B >/dev/null 2>&1 || true
  done < <(efibootmgr 2>/dev/null | sed -n 's/^Boot\([0-9A-Fa-f]\+\).*\(pertisk\|debian\|ubuntu\|grub\|GRUB\|Windows Boot Manager\).*/\1/pi')
  loader='\EFI\BOOT\BOOTX64.EFI'
  case "$(uname -m)" in
    aarch64|arm64) loader='\EFI\BOOT\BOOTAA64.EFI' ;;
  esac
  # AMI Aptio on mini PCs often only auto-discovers "Windows Boot Manager"
  # on internal NVMe — create that first and put it first in BootOrder.
  if efibootmgr -c -d "$disk" -p "$part" -l '\EFI\Microsoft\Boot\bootmgfw.efi' \
    -L 'Windows Boot Manager' >/dev/null 2>&1; then
    win="$(efibootmgr 2>/dev/null | sed -n 's/^Boot\([0-9A-Fa-f]\+\).*Windows Boot Manager.*/\1/pi' | tail -n1)"
  fi
  if ! efibootmgr -c -d "$disk" -p "$part" -l "$loader" -L pertisk; then
    echo "pertisk-install: efibootmgr could not create pertisk entry (WBM path may still work)" >&2
  fi
  num="$(efibootmgr 2>/dev/null | sed -n 's/^Boot\([0-9A-Fa-f]\+\).*pertisk.*/\1/p' | tail -n1)"
  order=""
  if [[ -n "${win:-}" ]]; then
    order="$win"
  fi
  if [[ -n "${num:-}" ]]; then
    order="${order:+$order,}$num"
  fi
  if [[ -n "$order" ]]; then
    # Prefer Windows Boot Manager, then pertisk, then whatever else remains.
    local rest
    rest="$(efibootmgr 2>/dev/null | awk -F': *' '/BootOrder/ {print $2}')"
    if [[ -n "$rest" ]]; then
      efibootmgr -o "${order},${rest}" >/dev/null 2>&1 || efibootmgr -o "$order" >/dev/null 2>&1 || true
    else
      efibootmgr -o "$order" >/dev/null 2>&1 || true
    fi
    # Next boot: Windows Boot Manager (AMI-friendly) if we have it.
    if [[ -n "${win:-}" ]]; then
      efibootmgr -n "$win" >/dev/null 2>&1 || true
    elif [[ -n "${num:-}" ]]; then
      efibootmgr -n "$num" >/dev/null 2>&1 || true
    fi
    echo "pertisk-install: UEFI BootOrder prefers Windows Boot Manager / pertisk on $disk p$part"
  fi
  efibootmgr -v 2>/dev/null | head -n 20 || true
}

wipe_target_disk() {
  local d="$1" p
  echo "pertisk-install: clearing leftover partitions/ESP/GRUB on $d"
  for p in $(lsblk -ln -o NAME "$d" 2>/dev/null | tail -n +2); do
    umount -R "/dev/${p}" >/dev/null 2>&1 || true
    wipefs -a "/dev/${p}" >/dev/null 2>&1 || true
  done
  umount -R "$d" >/dev/null 2>&1 || true
  wipefs -a "$d" >/dev/null 2>&1 || true
  sgdisk --zap-all "$d" >/dev/null 2>&1 || true
  # Do not dd the start of NVMe here: zeroing 16MiB after zap leaves some
  # kernels with no /dev/nvme0n1p* until reboot.
  rescan_parts "$d"
}

install_uefi() {
  local p1 p2 mnt uuid_root uuid_esp
  echo "Wiping $DISK (${gib}GiB): p1 ESP ${ESP_MIB}MiB + p2 ext4 root"
  wipe_target_disk "$DISK"
  parted -s "$DISK" mklabel gpt
  parted -s "$DISK" mkpart ESP fat32 1MiB $((ESP_MIB + 1))MiB
  parted -s "$DISK" mkpart root ext4 $((ESP_MIB + 1))MiB 100%
  parted -s "$DISK" set 1 esp on
  parted -s "$DISK" set 1 boot on || true
  read -r p1 p2 <<<"$(parts_for "$DISK")"
  wait_parts "$p1" "$p2"
  echo "pertisk-install: ESP $p1  root $p2"
  mkfs.fat -F32 -n PERTISKESP "$p1"
  mkfs.ext4 -F -L pertisk-root "$p2"
  mnt=/mnt/pertisk-install
  mkdir -p "$mnt"
  mount "$p2" "$mnt"
  mkdir -p "$mnt/boot/efi"
  mount "$p1" "$mnt/boot/efi"
  rsync -aHAX --numeric-ids --one-file-system --info=progress2 \
    --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/run \
    --exclude=/mnt --exclude=/tmp --exclude=/media \
    / "$mnt/"
  mkdir -p "$mnt/proc" "$mnt/sys" "$mnt/dev" "$mnt/run" "$mnt/tmp"
  sync
  mount --bind /dev "$mnt/dev"
  mount --bind /dev/pts "$mnt/dev/pts"
  mount -t proc proc "$mnt/proc"
  mount -t sysfs sys "$mnt/sys"
  uuid_root="$(blkid -s UUID -o value "$p2")"
  uuid_esp="$(blkid -s UUID -o value "$p1")"
  cat >"$mnt/etc/fstab" <<EOF
UUID=$uuid_root / ext4 defaults 0 1
UUID=$uuid_esp /boot/efi vfat umask=0077 0 2
EOF
  # Kernel lives on the live USB ESP (/boot/efi). rsync --one-file-system skips it.
  mkdir -p "$mnt/boot"
  for f in vmlinuz initrd.img; do
    if [[ -f "/boot/efi/${f}" ]]; then
      cp -f "/boot/efi/${f}" "$mnt/boot/${f}"
    elif [[ -f "/boot/efi/EFI/BOOT/${f}" ]]; then
      cp -f "/boot/efi/EFI/BOOT/${f}" "$mnt/boot/${f}"
    fi
  done
  # Rebuild initrd inside the target so NVMe/SATA modules are present (live USB
  # MODULES=dep may have omitted them — boots then die with "can't lookup blockdev").
  if [[ -x "$mnt/usr/sbin/update-initramfs" ]] || chroot "$mnt" command -v update-initramfs >/dev/null 2>&1; then
    echo "pertisk-install: rebuilding initramfs for NVMe/SATA boot"
    chroot "$mnt" update-initramfs -u -k all || chroot "$mnt" update-initramfs -c -k all || true
  fi
  chroot "$mnt" /usr/sbin/pertisk-esp-boot /boot/efi
  # Hard-verify removable + AMI paths before we claim success.
  local bootname=BOOTX64.EFI
  case "$(uname -m)" in aarch64|arm64) bootname=BOOTAA64.EFI ;; esac
  for need in \
    "$mnt/boot/efi/EFI/BOOT/$bootname" \
    "$mnt/boot/efi/EFI/BOOT/vmlinuz" \
    "$mnt/boot/efi/EFI/BOOT/initrd.img" \
    "$mnt/boot/efi/EFI/Microsoft/Boot/bootmgfw.efi"; do
    if [[ ! -s "$need" ]]; then
      echo "pertisk-install: missing boot file $need" >&2
      ls -laR "$mnt/boot/efi/EFI" >&2 || true
      die "ESP incomplete — not rebooting into a blank BIOS screen"
    fi
  done
  sync
  register_uefi_boot "$DISK" 1
  rm -f "$mnt/var/lib/pertisk/.firstboot-done"
  touch "$mnt/var/lib/pertisk/.installed-to-disk"
  umount "$mnt/dev/pts" "$mnt/dev" "$mnt/proc" "$mnt/sys" "$mnt/boot/efi" "$mnt"
  echo "pertisk-install: UEFI install done on $DISK"
  echo "pertisk-install: UNPLUG the USB stick, then boot:"
  echo "  BIOS → Boot → Windows Boot Manager   (or pertisk)"
}

install_rockchip() {
  local p1 p2 mnt uuid_root uuid_boot boot_fs
  echo "Wiping $DISK (${gib}GiB): ${RK_GAP_MIB}MiB U-Boot + ${BOOT_MIB}MiB /boot + ext4 root"
  sgdisk --zap-all "$DISK"
  sgdisk -a 8 -n1:$((RK_GAP_MIB * 2048)):+${BOOT_MIB}M -t1:0700 -c1:boot \
         -n2:0:0 -t2:8300 -c2:root \
         "$DISK"
  read -r p1 p2 <<<"$(parts_for "$DISK")"
  wait_parts "$p1" "$p2"
  boot_fs="vfat"
  if findmnt -n /boot >/dev/null 2>&1; then
    case "$(findmnt -n -o FSTYPE /boot)" in
      ext4|ext3) boot_fs="ext4" ;;
    esac
  fi
  if [[ "$boot_fs" == vfat ]]; then
    mkfs.fat -F32 -n opi_boot "$p1"
  else
    mkfs.ext4 -F -L opi_boot "$p1"
  fi
  mkfs.ext4 -F -L opi_root "$p2"
  mnt=/mnt/pertisk-install
  mkdir -p "$mnt"
  mount "$p2" "$mnt"
  rsync_root_to "$mnt"
  mkdir -p "$mnt/boot"
  mount "$p1" "$mnt/boot"
  if findmnt -n /boot >/dev/null 2>&1; then
    rsync -aHAX --numeric-ids /boot/ "$mnt/boot/"
  elif [[ -d /boot ]]; then
    rsync -aHAX --numeric-ids /boot/ "$mnt/boot/"
  fi
  mount --bind /dev "$mnt/dev"
  mount --bind /dev/pts "$mnt/dev/pts"
  mount -t proc proc "$mnt/proc"
  mount -t sysfs sys "$mnt/sys"
  uuid_root="$(blkid -s UUID -o value "$p2")"
  uuid_boot="$(blkid -s UUID -o value "$p1")"
  patch_boot_root "$mnt/boot" "$uuid_root"
  cat >"$mnt/etc/fstab" <<EOF
UUID=${uuid_root} / ext4 defaults,noatime,commit=600,errors=remount-ro 0 1
UUID=${uuid_boot} /boot ${boot_fs} defaults 0 2
EOF
  write_uboot_rockchip "$DISK"
  rm -f "$mnt/var/lib/pertisk/.firstboot-done"
  touch "$mnt/var/lib/pertisk/.installed-to-disk"
  printf 'rockchip\n' >"$mnt/etc/pertisk/family"
  umount "$mnt/dev/pts" "$mnt/dev" "$mnt/proc" "$mnt/sys" "$mnt/boot" "$mnt"
}

install_rpi() {
  local p1 p2 mnt uuid_root uuid_boot
  echo "Wiping $DISK (${gib}GiB): 512MiB firmware + ext4 root"
  sgdisk --zap-all "$DISK" 2>/dev/null || true
  parted -s "$DISK" mklabel gpt \
    mkpart firmware fat32 1MiB 513MiB \
    mkpart root ext4 513MiB 100%
  parted -s "$DISK" set 1 boot on || true
  read -r p1 p2 <<<"$(parts_for "$DISK")"
  wait_parts "$p1" "$p2"
  mkfs.fat -F32 -n bootfs "$p1"
  mkfs.ext4 -F -L rootfs "$p2"
  mnt=/mnt/pertisk-install
  mkdir -p "$mnt"
  mount "$p2" "$mnt"
  rsync_root_to "$mnt"
  mkdir -p "$mnt/boot/firmware"
  if [[ -d /boot/firmware ]]; then
    mount "$p1" "$mnt/boot/firmware"
    rsync -aHAX --numeric-ids /boot/firmware/ "$mnt/boot/firmware/"
  else
    mount "$p1" "$mnt/boot"
    rsync -aHAX --numeric-ids /boot/ "$mnt/boot/"
  fi
  uuid_root="$(blkid -s UUID -o value "$p2")"
  uuid_boot="$(blkid -s UUID -o value "$p1")"
  if [[ -d "$mnt/boot/firmware" ]]; then
    patch_boot_root "$mnt/boot/firmware" "$uuid_root"
    cat >"$mnt/etc/fstab" <<EOF
UUID=${uuid_root} / ext4 defaults,noatime 0 1
UUID=${uuid_boot} /boot/firmware vfat defaults 0 2
EOF
  else
    patch_boot_root "$mnt/boot" "$uuid_root"
    cat >"$mnt/etc/fstab" <<EOF
UUID=${uuid_root} / ext4 defaults,noatime 0 1
UUID=${uuid_boot} /boot vfat defaults 0 2
EOF
  fi
  rm -f "$mnt/var/lib/pertisk/.firstboot-done"
  touch "$mnt/var/lib/pertisk/.installed-to-disk"
  printf 'rpi\n' >"$mnt/etc/pertisk/family"
  umount -R "$mnt"
}

family="$(detect_family)"
case "$family" in
  uefi) install_uefi ;;
  rockchip) install_rockchip ;;
  rpi) install_rpi ;;
  *) die "unsupported family $family" ;;
esac

sync
mkdir -p /var/lib/pertisk
touch /var/lib/pertisk/.installed-to-disk
echo "pertisk-install: done."
if [[ "$family" == rockchip ]]; then
  echo "Power off, remove the SD card, then boot from $DISK (SPI + NVMe)."
  echo "If it does not start, put the SD back in."
else
  echo "Reboot. Firmware should start $DISK p1 (ESP); Linux root is p2."
  echo "If it goes to BIOS: unplug USB, pick the NVMe / pertisk / Windows Boot Manager entry."
fi
echo "UI will be http://<host>:7480/  (admin password in /etc/pertisk/admin after first boot)"
