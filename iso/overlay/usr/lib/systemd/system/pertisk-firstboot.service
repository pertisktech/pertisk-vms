[Unit]
Description=pertisk-vm first boot (NVMe install, config, admin password)
# Do not wait for DHCP. USB→NVMe copy must run with no cable / no IP.
After=local-fs.target
Before=pertiskd.service
ConditionPathExists=!/var/lib/pertisk/.firstboot-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/pertisk-firstboot
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
