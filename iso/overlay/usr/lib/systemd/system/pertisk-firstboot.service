[Unit]
Description=pertisk-vm first boot (config, admin password, kvm check)
After=local-fs.target network-online.target
Wants=network-online.target
Before=pertiskd.service
ConditionPathExists=!/var/lib/pertisk/.firstboot-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/pertisk-firstboot
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
