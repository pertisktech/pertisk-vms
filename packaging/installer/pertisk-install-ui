#!/bin/bash
# Console entry for the Alma ISO. Shows the Pertisk installer instead of Anaconda.
# Rescue and pertisk.autodisk still go straight to Anaconda.
set -uo pipefail

LOG=/tmp/pertisk-install-ui.log
SHARE=/usr/share/pertisk-installer
PORT="${PERTISK_INSTALLER_PORT:-8090}"
export PERTISK_INSTALLER_PORT="$PORT"
mkdir -p /run/pertisk
chmod 700 /run/pertisk || true
exec >>"$LOG" 2>&1
echo "pertisk-install-ui: $(date -Is 2>/dev/null || date)"

if grep -qw -E 'pertisk\.autodisk|inst\.rescue' /proc/cmdline 2>/dev/null; then
  echo "pertisk-install-ui: handing off to Anaconda ($(tr ' ' '\n' </proc/cmdline | grep -E 'pertisk.autodisk|inst.rescue' | head -n1))"
  exec /usr/sbin/anaconda
fi

python3 "$SHARE/server.py" &
echo $! >/run/pertisk/server.pid

same_dev() {
  [[ -e "$1" && -e "$2" ]] || return 1
  [[ "$(stat -c '%d:%i' "$1" 2>/dev/null || echo a)" == "$(stat -c '%d:%i' "$2" 2>/dev/null || echo b)" ]]
}

say() {
  # tty0, /dev/console, and tty1 are one screen on the appliance. The serial
  # port is a different device when this ISO runs as a guest, and that is the
  # console the management UI shows. Write the URL there too.
  local tty msg="$1"
  local -a targets=(/dev/console)
  local extra
  [[ -c /dev/console ]] || targets=(/dev/tty0)
  for extra in /dev/ttyS0 /dev/ttyAMA0 /dev/ttyS1; do
    [[ -c "$extra" ]] || continue
    same_dev "$extra" "${targets[0]}" && continue
    targets+=("$extra")
  done
  for tty in "${targets[@]}"; do
    [[ -c "$tty" ]] || continue
    printf '%s\n' "$msg" >"$tty" || true
  done
}

installer_ip() {
  ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -v '^127\.' | head -n1 || true
}

announce() {
  local ip url
  ip="$(installer_ip)"
  if [[ -n "$ip" ]]; then
    url="http://${ip}:${PORT}/"
  else
    url="http://127.0.0.1:${PORT}/"
  fi
  printf '%s\n' "$url" >/run/pertisk/url
  say "Pertisk Vms installer: open ${url}"
}

show_text_console() {
  if command -v chvt >/dev/null 2>&1; then
    chvt 1 || true
  fi
  announce
  say "Graphical installer stopped. Use the URL above."
}

install_webkit() {
  python3 - <<'PY' && return 0
import gi
gi.require_version("WebKit2", "4.1")
from gi.repository import WebKit2
PY
  local dir=""
  dir="$(find /run/install /run/media /media -type d -name pertisk-webkit 2>/dev/null | head -n1 || true)"
  if [[ -n "$dir" ]] && compgen -G "$dir/*.rpm" >/dev/null; then
    echo "pertisk-install-ui: installing WebKit from $dir"
    if dnf install -y --disablerepo='*' "$dir"/*.rpm; then
      return 0
    fi
    echo "pertisk-install-ui: local WebKit transaction failed, trying the Alma mirrors"
  fi
  dnf install -y webkit2gtk4.1
}

for _ in $(seq 1 20); do
  [[ -n "$(installer_ip)" ]] && break
  sleep 1
done
announce

if install_webkit; then
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR" || true
  if [[ -x /usr/libexec/anaconda/run-in-new-session && -x /usr/bin/gnome-kiosk ]]; then
    /usr/libexec/anaconda/run-in-new-session \
      --user root \
      --service anaconda \
      --session-type wayland \
      --session-class user \
      --vt 6 \
      gnome-kiosk --wayland --no-x11 --wayland-display wl-sysinstall-0 &
    echo $! >/run/pertisk/compositor.pid
    sock=""
    for _ in $(seq 1 200); do
      sock="$(find /run/user /run -name wl-sysinstall-0 -type s 2>/dev/null | head -n1 || true)"
      [[ -n "$sock" ]] && break
      sleep 0.1
    done
    if [[ -n "$sock" ]]; then
      export XDG_RUNTIME_DIR="$(dirname "$sock")"
      export WAYLAND_DISPLAY="$(basename "$sock")"
      export GDK_BACKEND=wayland
      export PERTISK_INSTALLER_URL="http://127.0.0.1:${PORT}/"
      python3 "$SHARE/kiosk.py" || {
        echo "pertisk-install-ui: kiosk exited"
        show_text_console
      }
    else
      echo "pertisk-install-ui: Wayland display did not start"
      show_text_console
    fi
  else
    echo "pertisk-install-ui: no kiosk compositor"
    show_text_console
  fi
else
  echo "pertisk-install-ui: WebKit is unavailable"
  show_text_console
fi

wait "$(cat /run/pertisk/server.pid)" || true
